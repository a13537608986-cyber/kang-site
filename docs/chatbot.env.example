# Server-only. Set these in your deployment secret manager or local .env.local.
# Never use NEXT_PUBLIC_ prefixes. Do not commit real credentials.
CHAT_API_KEY=
# OpenAI-compatible API root, INCLUDING /v1 when required; no /chat/completions suffix.
CHAT_BASE_URL=https://api.siliconflow.cn/v1
# User-selected SiliconFlow model; real availability still requires verification.
CHAT_MODEL=Qwen/Qwen3.6-35B-A3B
# Optional: exactly true or false. Omit both fields to use provider defaults.
CHAT_ENABLE_THINKING=true
# Optional integer 128..32768; only sent when thinking is explicitly enabled.
CHAT_THINKING_BUDGET=1024
